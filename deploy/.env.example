# Plantilla del .env de PRODUCCIÓN. En el servidor va en /opt/emprendehub/.env,
# con permisos 600 y NUNCA en git. Los secretos se generan con openssl:
#   openssl rand -base64 32     (DB_PASSWORD, ADMIN_CONTRASENA, SEMILLA_DEMO_CONTRASENA)
#   openssl rand -base64 48     (JWT_SECRET: tiene que ser Base64 de 256 bits o más)
# El detalle de cada variable está en docs/despliegue.md.

# --- Sitio ---
DOMINIO=emprendehub.tech
APP_URL=https://emprendehub.tech

# --- Base de datos ---
DB_NAME=emprendehub
DB_USER=emprendehub_prod
DB_PASSWORD=cambia-esto

# --- Sesión ---
JWT_SECRET=cambia-esto-por-base64
JWT_EXPIRATION=3600000

# --- Administrador (se crea con la base vacía) ---
ADMIN_CORREO=tu-correo@ejemplo.com
ADMIN_CONTRASENA=cambia-esto
ADMIN_NOMBRE=Administrador

# --- Comportamiento ---
# true: lo que se registra sale publicado sin revisión. Para volver a la
# moderación manual, borrar esta línea y reiniciar el backend.
MODERACION_AUTOMATICA=true
# true: con la base vacía crea negocios, clientes y opiniones de demostración.
SEMILLA_DEMO=true
# Obligatoria si SEMILLA_DEMO=true: la contraseña de todas las cuentas de demo.
SEMILLA_DEMO_CONTRASENA=cambia-esto
RECUPERACION_MINUTOS=30

# --- Correo ---
# Sin proveedor: un destino inalcanzable. La aplicación sigue funcionando y el
# fallo solo queda en el log. Con Brevo o Resend, ver docs/despliegue.md.
MAIL_HOST=127.0.0.1
MAIL_PORT=1
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=no-responder@emprendehub.tech
MAIL_TIMEOUT_MS=3000
